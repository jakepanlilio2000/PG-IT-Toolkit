<UserControl x:Class="PuregoldITToolkit.Tools.FormsTool.Views.ObView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Official Business (OB) Generator" FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0" Padding="0,0,10,0">
            <StackPanel>

                <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Instructions:" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="1. Fill out all required fields. Name and Position will auto-capitalize.&#x0a;2. Attach an image at its original resolution, or type a signature.&#x0a;3. Click or drag on the preview to position the image. Use arrow keys for precise movement (Shift = 10 pixels).&#x0a;4. Save the finished form as a high-quality image." TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Employee Profile" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="{StaticResource BrandPrimary}"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Employee Name *" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding FormData.EmployeeName, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                        </StackPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,15" Width="250">
                                <TextBlock Text="Position *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormData.Position, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15" Width="200">
                                <TextBlock Text="Department *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormData.Department, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Trip Configuration &amp; Signature" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="{StaticResource BrandPrimary}"/>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="OB Schedule (Date &amp; Time)" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding FormData.ObSchedule, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,15" Width="160">
                                <TextBlock Text="Date Filed (Optional)" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding FormData.DateFiled}" Height="34" Padding="5"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,15" Width="180">
                                <TextBlock Text="Typed Signature" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormData.EmployeeSignature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="— OR ATTACH IMAGE —" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,5" Width="180" HorizontalAlignment="Left">
                            <Button Command="{Binding BrowseSignatureCommand}" Content="ATTACH IMAGE..." Background="{StaticResource BrandAccent}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Width="85" Margin="0,0,10,8"><TextBlock Text="Left (px)" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding FormData.ImageX, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/></StackPanel>
                            <StackPanel Width="85" Margin="0,0,10,8"><TextBlock Text="Top (px)" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding FormData.ImageY, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/></StackPanel>
                            <StackPanel Width="95" Margin="0,0,10,8"><TextBlock Text="Width (px)" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding FormData.ImageWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/></StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Reset position" Command="{Binding ResetImageCommand}" Style="{StaticResource NeutralButton}" Padding="10,6" Margin="0,0,8,0"/>
                            <Button Content="Remove image" Command="{Binding RemoveImageCommand}" Style="{StaticResource NeutralButton}" Padding="10,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding FormData.SignatureImagePath, StringFormat='Attached: {0}'}" FontSize="11" Foreground="{StaticResource BtnSuccess}" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Preview Pane -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Preview · high-quality image" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                <Border Grid.Row="1" x:Name="PreviewSurface" Focusable="True" Background="White" BorderBrush="{StaticResource BorderFocus}" BorderThickness="2" Cursor="SizeAll"
                        KeyDown="PreviewSurface_KeyDown" MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown" MouseMove="PreviewSurface_MouseMove" MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                    <Image x:Name="PreviewImage" Source="{Binding LivePreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Grid.Row="2" Text="Click or drag to place your image. Arrow keys: 1 px · Shift + arrows: 10 px. Adjust width to resize proportionally." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Execution -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,15,0" TextWrapping="Wrap" Text="{Binding StatusMessage}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding ExportCommand}" Content="GENERATE OB IMAGE" FontSize="14" Style="{StaticResource SuccessButton}" Padding="24,12" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
