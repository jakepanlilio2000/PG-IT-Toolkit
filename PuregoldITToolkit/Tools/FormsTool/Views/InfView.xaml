<UserControl x:Class="PuregoldITToolkit.Tools.FormsTool.Views.InfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TbHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TbHeaderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="INF · Item not found" FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="Prepare an email for items with missing or incorrect prices." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <TextBlock Text="Add the items, any extra columns, and screenshots, then prepare the email." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                <!-- 1. Store Context & Distribution Routing -->
                <Expander Header="Store &amp; email recipients" Background="{StaticResource BgCard}" Padding="14" Margin="0,0,0,15" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Store and recipients" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,15"/>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Margin="0,0,20,0" Width="220">
                                <TextBlock Text="Store Name" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="To" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding ToAddresses, UpdateSourceTrigger=PropertyChanged}" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,0" Width="380">
                                <TextBlock Text="Cc" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CcAddresses, UpdateSourceTrigger=PropertyChanged}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Width="380">
                                <TextBlock Text="Additional Cc" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding AdditionalCc, UpdateSourceTrigger=PropertyChanged}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- 2. Item Entry -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Items" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,15"/>

                        <WrapPanel Margin="0,0,0,20">
                            <TextBlock Text="INF Form Type:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextPrimary}"/>
                            <ComboBox ItemsSource="{Binding InfTypes}" SelectedItem="{Binding SelectedInfType}" Width="350" Height="34" Padding="5"/>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,15,12" Width="90">
                                <TextBlock Text="Store Code *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.StoreCode, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="120">
                                <TextBlock Text="Reg. SKU *" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.Sku, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="140" Visibility="{Binding IsType4Apar, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Gen. SKU (APAR) *" Style="{StaticResource FormLabel}" Foreground="{StaticResource BrandPrimary}"/>
                                <TextBox Text="{Binding CurrentEntry.GeneratedSku, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{StaticResource BrandPrimary}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="140">
                                <TextBlock Text="UPC" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.Upc, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="100">
                                <TextBlock Text="PurePOS Price" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.PurePosPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="100">
                                <TextBlock Text="MMS Price" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.MmsPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="220">
                                <TextBlock Text="Description" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,12" Width="80">
                                <TextBlock Text="Is Promo?" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CurrentEntry.IsPromo, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPromoLocked}" Background="{StaticResource BgApp}"/>
                            </StackPanel>
                        </WrapPanel>

                        <Border Background="{StaticResource BgApp}" Padding="12" CornerRadius="6" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Custom columns" Style="{StaticResource FormLabel}"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <TextBox Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" ToolTip="Column name, e.g. Remarks, Supplier, or Ticket reference"/>
                                    <Button Content="+ Add column" Command="{Binding AddColumnCommand}" Style="{StaticResource ActionButton}" Padding="12,6"/>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding CurrentEntry.CustomFields}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="220" Margin="0,0,12,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}" Padding="5,2" Margin="6,0,0,4"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FormLabel}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding AddToTableCommand}" Content="+ ADD ITEM TO TABLE" Style="{StaticResource ActionButton}" Padding="20,10" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Data Table -->
                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgCard}" Margin="0,0,0,15" MinHeight="150" MaxHeight="250">
                    <DataGrid x:Name="ItemsTable" ItemsSource="{Binding InfTable}" AutoGenerateColumns="False" CanUserAddRows="False" MinColumnWidth="75"
                              HeadersVisibility="Column" Background="{StaticResource BgCard}" RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource BgApp}"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderLight}" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Store" Binding="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Width="70"/>
                            <DataGridTextColumn Header="Reg. SKU" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn x:Name="GeneratedSkuColumn" Header="Generated SKU (APAR)" Binding="{Binding GeneratedSku, UpdateSourceTrigger=PropertyChanged}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsType4Apar, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="UPC" Binding="{Binding Upc, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="PurePos Price" Binding="{Binding PurePosPrice, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="MMS Price" Binding="{Binding MmsPrice, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Is Promo?" Binding="{Binding IsPromo, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTemplateColumn Header="Action" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 3. Screenshots -->
                <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Screenshots (optional)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,0,0,10"/>
                        <TextBlock Text="Selected images will be embedded inline at the bottom of the email." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                        <Button Command="{Binding AddScreenshotCommand}" Content="📷 BROWSE IMAGES..." Background="{StaticResource BrandAccent}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" BorderThickness="0" Padding="15,8" HorizontalAlignment="Left" Margin="0,0,0,10" Cursor="Hand"/>
                        <ItemsControl ItemsSource="{Binding ScreenshotPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,5" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.RemoveScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✕" Style="{StaticResource DangerButton}" Padding="8,2" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontStyle="Italic"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Live Preview -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Email preview" Background="{StaticResource BrandPrimaryDark}" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,8"/>

                        <Grid Grid.Row="2" Margin="12,2,12,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="To:" Style="{StaticResource TbHeaderLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding InfPreviewTo}" Style="{StaticResource TbHeaderValue}" Foreground="#00529B"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="12,2,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cc:" Style="{StaticResource TbHeaderLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding InfPreviewCc}" Style="{StaticResource TbHeaderValue}" Foreground="#00529B"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="12,2,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Subject:" Style="{StaticResource TbHeaderLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding InfPreviewSubject}" Style="{StaticResource TbHeaderValue}" FontWeight="Bold"/>
                        </Grid>

                        <TextBox Grid.Row="5" Text="{Binding InfPreviewBody, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#FFFFFF" Foreground="#000000" FontFamily="Consolas, Calibri" FontSize="13" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" MinHeight="140"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Execution Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="15,10" Margin="-15,10,-15,-15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock TextWrapping="Wrap" Margin="0,0,15,0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ExportCommand}" Content="DRAFT INF EMAIL" FontSize="13" Style="{StaticResource SuccessButton}" Padding="25,12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
