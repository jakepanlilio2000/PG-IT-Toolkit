<UserControl x:Class="PuregoldITToolkit.Tools.PureposTool.Views.PureposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PuregoldITToolkit.Core.Converters"
             xmlns:helpers="clr-namespace:PuregoldITToolkit.Core.Helpers">

    <UserControl.Resources>
        <conv:InverseBoolToVisConverter x:Key="InverseBoolVisConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolkitTab" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgApp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgApp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Category Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Workspace Content + Console Split -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CATEGORY NAVIGATION TABS -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save check results" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource NeutralButton}" Padding="14,8" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="PurePOS tools" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryDark}"/>
                    <TextBlock Text="Check connections, manage files, and run store tasks." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource BrandPrimary}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbDiagnostics" Content="Connection checks" IsChecked="True" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbFileStoreUtils" Content="Files and services" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbAutoPerm" Content="Permissions" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbManualEj" Content="EJ backup" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbCli" Content="Commands" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbEod" Content="EOD" Style="{StaticResource ToolkitTab}"/>
                    <RadioButton x:Name="RbBirCrmSync" Content="BIR &amp; CRM" Style="{StaticResource ToolkitTab}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN STAGE (LEFT: TOOL WORKSPACE, RIGHT: INLINE CONSOLE) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340" MinWidth="270"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderLight}"/>

            <!-- ======================================================== -->
            <!-- TAB 1: POS DIAGNOSTICS & NETWORK UTILITIES               -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"
                          Visibility="{Binding IsChecked, ElementName=RbDiagnostics, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- LAN PING SUITE CARD -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Check server and registers" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBlock Text="Check whether the server and registers can be reached." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Command="{Binding RunNetworkPingSuiteCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        Content="Check connections"
                                        Background="{StaticResource BrandAccent}"
                                        Foreground="{StaticResource BrandPrimaryDark}"
                                        FontWeight="Bold"
                                        Padding="14,6"
                                        HorizontalAlignment="Right"
                                        Cursor="Hand"/>
                            </StackPanel>

                            <!-- Configuration Strip -->
                            <WrapPanel Margin="0,0,0,10">
                                <StackPanel Width="150" Margin="0,0,10,6">
                                    <TextBlock Text="Gateway IP:" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding DiagnosticGatewayIp, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,10,6">
                                    <TextBlock Text="Server / CONSO IP:" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding DiagnosticServerIp, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,6">
                                    <TextBlock Text="Total Lanes:" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding DiagnosticTotalLanes, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Ping Results Grid/Table -->
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4" MaxHeight="220">
                                <DataGrid ItemsSource="{Binding PingTargets}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" Background="#FFFFFF">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="160" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                                        <DataGridTemplateColumn Header="Status" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="2,1">
                                                        <TextBlock Text="{Binding Status}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs, StringFormat='{}{0} ms'}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- FAST PORT CHECKER CARD -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Check services" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBlock Text="Check whether the server’s services can be reached." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Button Command="{Binding RunPortCheckSuiteCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        Content="Check services"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        Padding="14,6"
                                        HorizontalAlignment="Right"
                                        Cursor="Hand"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Target Host / IP:" Style="{StaticResource FormLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PortCheckTargetIp, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4" MaxHeight="220">
                                <DataGrid ItemsSource="{Binding PortResults}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" Background="#FFFFFF">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Service / Protocol" Binding="{Binding ServiceName}" Width="220"/>
                                        <DataGridTemplateColumn Header="State" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="2,1">
                                                        <TextBlock Text="{Binding Status}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Roundtrip" Binding="{Binding LatencyMs, StringFormat='{}{0} ms'}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- TAB 2: FILE & STORE UTILITIES                           -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"
                          Visibility="{Binding IsChecked, ElementName=RbFileStoreUtils, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- LOG CLEANUP & ARCHIVER CARD -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🧹 Directory Log Cleanup &amp; Cache Archiver" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Review storage usage, clear temporary EJ files, or archive application logs. Saved data is retained." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Cache directories table -->
                            <ItemsControl ItemsSource="{Binding CacheDirectories}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DirectoryName}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource BrandPrimary}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel>
                                <Button Command="{Binding ScanCachesCommand}" Content="🔄 Refresh Caches" Style="{StaticResource SubtleButton}" Margin="0,0,8,6"/>
                                <Button Command="{Binding CleanCachesCommand}" Content="🧹 Clean &amp; Free Temp Space" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,6" BorderThickness="0" Margin="0,0,8,6" Cursor="Hand"/>
                                <Button Command="{Binding ArchiveLogsCommand}" Content="📦 Archive Logs to Zip" Background="{StaticResource BrandAccent}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="12,6" BorderThickness="0" Margin="0,0,8,6" Cursor="Hand"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- QUICK SHORTCUTS & ADAPTER CONFIG -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚡ Quick Shortcuts &amp; Service Controls" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Perform common store system maintenance tasks with a single click." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                            <!-- Service Restart Strip -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Restart Service:" Style="{StaticResource FormLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableServices}" SelectedItem="{Binding SelectedServiceToRestart}" Height="36" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Command="{Binding RestartServiceCommand}" Content="🔄 Restart" Style="{StaticResource SubtleButton}"/>
                            </Grid>

                            <!-- Path Explorer Buttons -->
                            <TextBlock Text="View / Open Critical Back-Office Paths:" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,15">
                                <Button Command="{Binding OpenCriticalPathCommand}" CommandParameter="ejcache" Content="📁 EJ Cache" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                                <Button Command="{Binding OpenCriticalPathCommand}" CommandParameter="output" Content="📂 Form Outputs" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                                <Button Command="{Binding OpenCriticalPathCommand}" CommandParameter="logs" Content="📜 App Logs" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                                <Button Command="{Binding OpenCriticalPathCommand}" CommandParameter="temp" Content="🗑️ Windows Temp" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                                <Button Command="{Binding OpenCriticalPathCommand}" CommandParameter="app" Content="📦 App Directory" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                            </WrapPanel>

                            <!-- Network Adapter Config -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📶 System Network Adapter Configuration" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandPrimaryDark}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding RefreshNetworkAdaptersCommand}" Content="🔄" Style="{StaticResource SubtleButton}" Padding="6,2" Margin="0,0,6,0"/>
                                    <Button Command="{Binding CopyNetworkInfoCommand}" Content="📋 Copy Details" Style="{StaticResource SubtleButton}" Padding="8,2"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="4" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="address Address:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.IpAddress}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandPrimary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                        <TextBlock Text="Subnet Mask:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.SubnetMask}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="Default Gateway:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.Gateway}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                        <TextBlock Text="DNS Server(s):" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.DnsServers}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Physical (MAC) Address:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.MacAddress}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="Link Speed &amp; Status:" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SelectedAdapter.Speed, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- TAB 3: AUTO PERMISSION                                  -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding IsChecked, ElementName=RbAutoPerm, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Update permissions" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Update permissions on the registers and CONSO server." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,8,0,12">
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="CONSO address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding PermissionData.LiveServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                        <StackPanel Width="150" HorizontalAlignment="Left">
                            <TextBlock Text="Total POS Lanes:" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding PermissionData.TotalLanes}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding RunPermissionCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Content="Update permissions"
                            Style="{StaticResource DangerButton}"
                            Padding="20,12"
                            HorizontalAlignment="Left"
                            FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 4: MANUAL EJ SAVE                                   -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding IsChecked, ElementName=RbManualEj, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🗃️ Manual EJ Synchronization" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Retrieves transaction journals for specified date ranges." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                        <WrapPanel Margin="0,8,0,12">
                            <StackPanel Width="170" Margin="0,0,12,10">
                                <TextBlock Text="CONSO address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EjData.LiveServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="100" Margin="0,0,12,10">
                                <TextBlock Text="Store code" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EjData.StoreCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="FTP host" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EjData.FtpServer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Date From:" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding EjData.DateFrom}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Date To:" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding EjData.DateTo}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding RunEjSaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Content="📥 TRIGGER MANUAL EJ SAVE"
                                Background="{StaticResource BrandPrimary}"
                                Foreground="#FFFFFF"
                                FontWeight="Bold"
                                Padding="18,10"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 5: REMOTE CLI / SSH                                 -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding IsChecked, ElementName=RbCli, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Run a command" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose a saved task or enter a command for the selected register or server." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                        <WrapPanel Margin="0,8,0,12">
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="Register or server address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CliTargetIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="CONSO address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding PermissionData.LiveServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10">
                                <TextBlock Text="Batch lane count" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding PermissionData.TotalLanes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Saved task:" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableScripts}" SelectedItem="{Binding SelectedScript}" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Command:" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding CliCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Command="{Binding RunSingleCliCommand}" Content="▶️ Run on Target" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                            <Button Command="{Binding RunAllPosCliCommand}" Content="⚡ Run on ALL Lanes" Background="{StaticResource BrandAccent}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="12,6" BorderThickness="0" Margin="0,0,6,6" Cursor="Hand"/>
                            <Button Command="{Binding RunConsoCliCommand}" Content="🖥️ Run on CONSO" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                            <Button Command="{Binding OpenPuttyCommand}" Content="🪟 Launch PuTTY" Style="{StaticResource SubtleButton}" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 6: EOD GENERATOR                                    -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding IsChecked, ElementName=RbEod, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Send EOD files" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Prepare and send the store’s end-of-day files." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>

                        <WrapPanel Margin="0,8,0,12">
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="CONSO address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EodData.LiveServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="100" Margin="0,0,12,10">
                                <TextBlock Text="Store code" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EodData.StoreCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="230" Margin="0,0,12,10">
                                <TextBlock Text="Store name" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EodData.StoreName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="230" Margin="0,0,12,10">
                                <TextBlock Text="Store manager" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EodData.StoreManager, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,10">
                                <TextBlock Text="Store officer(s)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding EodData.StoreOfficer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding EodData.UseYesterday}" Content="Use Yesterday's Audit Date" Margin="0,0,0,10" FontWeight="SemiBold"/>
                        <CheckBox IsChecked="{Binding EodData.TestModeEmail}" Content="Test Mode (Send to Admin)" Margin="0,0,0,15" FontWeight="SemiBold"/>

                        <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="{Binding EodPreviewSubject, StringFormat='Subject: {0}'}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EodPreviewAttachment}" Foreground="{StaticResource BrandPrimary}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EodPreviewTo, StringFormat='To: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding RunEodCommand}" Content="📤 GENERATE &amp; DISPATCH EOD" Background="{StaticResource BrandPrimary}" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,10" HorizontalAlignment="Left" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 7: BIR & CRM SYNC                                   -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding IsChecked, ElementName=RbBirCrmSync, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="BIR and CRM" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Send BIR, CRM, and promo records for the selected dates." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                        <WrapPanel Margin="0,8,0,12">
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="CONSO address" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding AutoSyncData.LiveServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="100" Margin="0,0,12,10">
                                <TextBlock Text="Store code" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding AutoSyncData.StoreCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,10">
                                <TextBlock Text="BIR / CRM date" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding AutoSyncData.TargetDate}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,10">
                                <TextBlock Text="Promo from" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding AutoSyncData.DateFrom}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,10">
                                <TextBlock Text="Promo to" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding AutoSyncData.DateTo}"/>
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Include diagnostic output" IsChecked="{Binding AutoSyncData.DebugMode}" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,15">
                            <Button Command="{Binding RunBirEisCommand}" Content="🏛️ Run BIR-EIS Sync" Style="{StaticResource SubtleButton}" Margin="0,0,10,6"/>
                            <Button Command="{Binding RunCrmPointsCommand}" Content="💳 Run CRM Loyalty Sync" Style="{StaticResource SubtleButton}" Margin="0,0,10,6"/>
                            <Button Command="{Binding RunPromoAvailmentCommand}" Content="🏷️ Run Promo Availment" Style="{StaticResource SubtleButton}" Margin="0,0,10,6"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== -->
            <!-- DOCKED LIVE CONSOLE OUTPUT (RIGHT COLUMN)                -->
            <!-- ======================================================== -->
            <Border Grid.Column="2" Background="#0A0F1D" BorderBrush="{StaticResource DarkSlateHeader}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="Activity" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ProgressBar Width="70" Height="10" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveConsoleCommand}" Content="Save" Background="Transparent" Foreground="#CBD5E1" Padding="6,2" Margin="0,0,5,0"/>
                            <Button Command="{Binding ClearLogCommand}" Content="🧹 Clear" Background="Transparent" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8" FontSize="10" Padding="6,2" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" TextChanged="Console_TextChanged"
                             Text="{Binding CliOutput, Mode=OneWay}"
                             Background="Transparent"
                             Foreground="#E2E8F0"
                             FontFamily="Consolas, Lucida Console"
                             FontSize="11"
                             IsReadOnly="True"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
