<UserControl x:Class="PuregoldITToolkit.Tools.EJConsolidator.Views.EJConsolidatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PuregoldITToolkit.Core.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SegmentedTab" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgApp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimaryDark}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,25,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimaryDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimaryDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="EJ Consolidator" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}"/>
                    <TextBlock Text="Read, combine, and search receipts from your store or FTP." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenOutputDirCommand}" Content="Open output folder" Style="{StaticResource NeutralButton}" Padding="15,8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

                <!-- SECTION 1: EXECUTION MODE SELECTION (MUTUALLY EXCLUSIVE) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. Where to get receipts" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Local reads from your live/CONSO server. FTP reads your store’s uploaded receipts. Choose FTP Others for another store." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>

                        <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Local · live / CONSO" IsChecked="{Binding IsModeLocal}" Style="{StaticResource ModeRadio}"/>
                                <RadioButton Content="FTP · own store" IsChecked="{Binding IsModeFtp}" Style="{StaticResource ModeRadio}"/>
                                <RadioButton Content="FTP Others" IsChecked="{Binding IsModeFtpOthers}" Style="{StaticResource ModeRadio}"/>
                            </StackPanel>
                        </Border>



                        <StackPanel Visibility="{Binding IsLocalSettingsActive, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="Live / CONSO server address" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding LiveServerIp, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- DYNAMIC FIELDS: FTP MODE SETTINGS -->
                        <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,5" Visibility="{Binding IsFtpSettingsActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="FTP server" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandPrimary}"/>
                                    <CheckBox Content="Include all stores" IsChecked="{Binding ProcessAllStores}" IsEnabled="{Binding IsModeFtpOthers}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}"/>
                                </Grid>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8" Width="180">
                                        <TextBlock Text="FTP Host:" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding FtpHost, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="70">
                                        <TextBlock Text="Port:" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding FtpPort, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="80">
                                        <TextBlock Text="Timeout (s):" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding FtpTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox Content="Passive FTP" IsChecked="{Binding FtpPassiveMode}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <CheckBox Content="Use previously downloaded files for past dates" IsChecked="{Binding UseCachedData}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: TARGET STORE & DATE RANGE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. Store and dates" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding IsFtpSettingsActive}">
                            <ComboBox ItemsSource="{Binding KnownStores}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="DisplayName" Width="330" Margin="0,0,10,0" ToolTip="Select a store detected from FTP"/>
                            <Button Content="Detect FTP stores" Command="{Binding RefreshStoresCommand}" Style="{StaticResource NeutralButton}" Padding="12,7"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DetectedStore}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,12"/>

                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,20,10" Width="120">
                                <TextBlock Text="Store Code" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>



                            <StackPanel Margin="0,0,20,10">
                                <TextBlock Text="Dates" Style="{StaticResource FormLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <DatePicker SelectedDate="{Binding StartDate}" Width="140" Margin="0,0,10,0"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondary}"/>
                                    <DatePicker SelectedDate="{Binding EndDate}" Width="140"/>
                                </StackPanel>
                            </StackPanel>


                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: OPERATION MODE & TRANSACTION FINDER -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. What to do" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton Content="Combine receipts" IsChecked="{Binding IsModeConsolidator}" Style="{StaticResource SegmentedTab}"/>
                            <RadioButton Content="Find a receipt" IsChecked="{Binding IsModeTrxFinder}" Style="{StaticResource SegmentedTab}"/>
                        </StackPanel>

                        <!-- Batch Settings -->
                        <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Visibility="{Binding IsModeConsolidator, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="Lanes (1,3-5):" Width="100" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding PosLanes, UpdateSourceTrigger=PropertyChanged}" Width="350"/>
                                    <CheckBox Content="Save all dates in one file" IsChecked="{Binding MergeAllIntoOneFile}" VerticalAlignment="Center" Margin="25,0,0,0" FontWeight="SemiBold"/>
                                </WrapPanel>
                                <TextBlock Text="* Leave blank to merge all POS terminals. Or list comma-separated lane numbers (e.g. 1, 3, 5)." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="100,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Finder Settings -->
                        <Border Background="{StaticResource BgHighlight}" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" CornerRadius="6" Padding="15" Visibility="{Binding IsModeTrxFinder, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Receipt number:" Width="100" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding TargetTrxNumber, UpdateSourceTrigger=PropertyChanged}" Width="350" FontWeight="Bold"/>
                                </WrapPanel>
                                <TextBlock Text="Enter the full receipt number, or just its ending number without leading zeros. Example: 123 finds 7220010000000123." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="100,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: SMART CONTENT FILTERS -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsModeConsolidator, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Reset filters" Command="{Binding ResetFiltersCommand}" Style="{StaticResource NeutralButton}" Padding="12,6"/>
                            <TextBlock Text="4. Narrow the results" Style="{StaticResource SectionHeader}"/>
                        </DockPanel>
                        <TextBlock Text="Fill in the details you want to match. Leave the rest blank. Select both Senior and PWD to include either." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <StackPanel Width="260" Margin="0,0,12,12"><TextBlock Text="Contains text" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,12,12"><TextBlock Text="Exclude text" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12"><TextBlock Text="Payment method" Style="{StaticResource FormLabel}"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/></StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,12"><TextBlock Text="Receipt type" Style="{StaticResource FormLabel}"/><ComboBox ItemsSource="{Binding ReceiptTypes}" SelectedItem="{Binding ReceiptType}"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,12"><TextBlock Text="Minimum total" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,12"><TextBlock Text="Maximum total" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding MaximumAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,12"><TextBlock Text="From time (HH:mm)" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,12"><TextBlock Text="To time (HH:mm)" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </WrapPanel>

                        <!-- Quick Toggles -->
                        <TextBlock Text="Receipt Classification Toggles" Style="{StaticResource FormLabel}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,15">
                            <ToggleButton Content="🧾 Second Receipt Only" IsChecked="{Binding SecondReceiptOnly}" Style="{StaticResource TileToggleStyle}"/>
                            <ToggleButton Content="📱 GCash Barcode Only" IsChecked="{Binding GcashBarcodeOnly}" Style="{StaticResource TileToggleStyle}"/>
                            <ToggleButton Content="⚡ HACS Online Only" IsChecked="{Binding HacsOnlineOnly}" Style="{StaticResource TileToggleStyle}"/>
                            <ToggleButton Content="📊 X-Read / Z-Read Only" IsChecked="{Binding XReadZReadOnly}" Style="{StaticResource TileToggleStyle}"/>
                            <ToggleButton Content="👴 Senior Citizen (SC)" IsChecked="{Binding SeniorCitizenOnly}" Style="{StaticResource TileToggleStyle}"/>
                            <ToggleButton Content="♿ PWD Only" IsChecked="{Binding PwdOnly}" Style="{StaticResource TileToggleStyle}"/>
                        </WrapPanel>

                        <!-- Precision Search Fields -->
                        <TextBlock Text="Precision Field Matching" Style="{StaticResource FormLabel}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="Cashier Name/ID:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding SpecificCashier, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="Bagger Name/ID:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding SpecificBagger, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="Member Card Last 4:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FilterCardLast4, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="Member / Customer Name:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FilterMemberName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="140">
                                <TextBlock Text="Exact Total Amount:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FilterExactAmount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="Product / SKU / Text:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FilterProductOrSku, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,15,10" Width="160">
                                <TextBlock Text="SC / PWD ID #:" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FilterScPwdId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Expander Grid.Row="2" IsExpanded="{Binding IsResultsExpanded}" Background="{StaticResource BgCard}" Margin="0,10,0,0" Padding="10">
            <Expander.Header><TextBlock Text="{Binding ResultsSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/></Expander.Header>
            <Grid Height="220" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,10,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="85"/>
                        <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionNumber}" Width="150"/>
                        <DataGridTextColumn Header="Source / Store" Binding="{Binding SourceFile}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Grid.Column="1" Text="{Binding SelectedResult.ReceiptText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Expander>

        <!-- SECTION 5: FOOTER, PROGRESS BAR & EXECUTION -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="15,12" Margin="-15,10,-15,-15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress Details Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,15,0" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" Background="{StaticResource BgApp}" Foreground="{StaticResource BtnSuccess}"/>
                    </StackPanel>
                </Grid>

                <!-- Actions -->
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelCommand}" Content="CANCEL" Style="{StaticResource DangerButton}" Padding="20,12" Margin="0,0,10,0" IsEnabled="{Binding CanCancel}"/>
                        <Button Command="{Binding ProcessCommand}" Content="START" Style="{StaticResource SuccessButton}" Padding="30,12" FontSize="14" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
