<UserControl x:Class="PuregoldITToolkit.Tools.FtpBrowserTool.Views.FtpBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SegmentedTab" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgApp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Border Background="{StaticResource BtnSuccess}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="🌐 Linked to Global Settings" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Select Target Store" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding StoresList}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="DisplayText" Width="300" Height="38"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <RadioButton Content="📂 OTHERS FOLDER" IsChecked="{Binding IsTabOthers}" Style="{StaticResource SegmentedTab}"/>
                    <RadioButton Content="📤 FROM HO FOLDER" IsChecked="{Binding IsTabFromHo}" Style="{StaticResource SegmentedTab}"/>
                    <RadioButton Content="📁 ROOT FTP" IsChecked="{Binding IsTabRoot}" Style="{StaticResource SegmentedTab}"/>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="🔄 REFRESH" Background="{StaticResource BgHighlight}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" Padding="15,0" VerticalAlignment="Bottom" Height="38" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgCard}" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgApp}" Padding="15,10" CornerRadius="6,6,0,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding CurrentPath, StringFormat='Current Path: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryDark}" TextTrimming="CharacterEllipsis"/>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilesList}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          HeadersVisibility="Column" Background="{StaticResource BgCard}" RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource BgApp}" 
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderLight}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding TypeIcon}" Width="35">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" FontWeight="Bold" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat='MM/dd/yyyy hh:mm tt'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="10" Margin="0,0,0,12" Foreground="{StaticResource BrandPrimary}"/>
                        <TextBlock Text="Communicating with FTP..." FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Command="{Binding DownloadCommand}" Content="💾 DOWNLOAD SELECTED FILE" Style="{StaticResource SuccessButton}" Padding="30,15" HorizontalAlignment="Right" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>