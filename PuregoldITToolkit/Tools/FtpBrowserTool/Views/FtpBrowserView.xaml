<UserControl x:Class="PuregoldITToolkit.Tools.FtpBrowserTool.Views.FtpBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SegmentedTab" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgApp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="0,0,8,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Border Background="{StaticResource BtnSuccess}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="🌐 Linked to Global Settings" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Grid>
                        <TextBlock Text="Select Target Store" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                        <Button Command="{Binding RefreshCacheCommand}" Content="Sync FTP Stores" Background="Transparent" Foreground="{StaticResource BrandPrimaryDark}" BorderThickness="0" HorizontalAlignment="Right" FontSize="11" FontStyle="Italic" Cursor="Hand" Padding="0"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding StoresList}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="DisplayText" Width="300" Height="38"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock Text="Quick Access Server Shortcuts:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" FontStyle="Italic"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="📂 OTHERS (.177)" GroupName="FtpTabs" IsChecked="{Binding IsTabOthers}" Style="{StaticResource SegmentedTab}"/>
                        <RadioButton Content="📤 FROM HO (.177)" GroupName="FtpTabs" IsChecked="{Binding IsTabFromHo}" Style="{StaticResource SegmentedTab}"/>
                        <RadioButton Content="💾 .132 INSTALLERS" GroupName="FtpTabs" IsChecked="{Binding IsTabInstallers}" Style="{StaticResource SegmentedTab}"/>
                        <RadioButton Content="📁 ROOT (.177)" GroupName="FtpTabs" IsChecked="{Binding IsTabRoot}" Style="{StaticResource SegmentedTab}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgCard}" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgApp}" Padding="15,10" CornerRadius="6,6,0,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding GoUpCommand}" Content="⬆ UP" Background="{StaticResource BgHighlight}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="12,5" Margin="0,0,15,0" BorderThickness="1" BorderBrush="{StaticResource BorderLight}" Cursor="Hand"/>
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="🔄" Background="Transparent" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="10,5" Margin="0,0,15,0" BorderThickness="1" BorderBrush="{StaticResource BorderLight}" Cursor="Hand" ToolTip="Refresh Directory"/>

                        <TextBlock Grid.Column="2" Text="{Binding CurrentPath, StringFormat='Path: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Command="{Binding UploadCommand}" Content="📤 UPLOAD" Background="{StaticResource BrandPrimary}" Foreground="White" FontWeight="Bold" Padding="15,5" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                            <Button Command="{Binding DownloadMultipleCommand}" Content="💾 DOWNLOAD" Background="{StaticResource BtnSuccess}" Foreground="White" FontWeight="Bold" Padding="15,5" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>

                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="5" VerticalContentAlignment="Center" Background="#FFFFFF" Margin="0,0,10,0"/>
                            <Button Command="{Binding DeepSearchCommand}" Content="DEEP SEARCH" Background="{StaticResource BrandAccent}" Foreground="{StaticResource BrandPrimaryDark}" FontWeight="Bold" Padding="15,2" BorderThickness="0" Cursor="Hand" ToolTip="Scan all subdirectories remotely"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="FilesGrid" ItemsSource="{Binding FilteredFilesList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          SelectionMode="Extended" AllowDrop="True" Drop="FilesGrid_Drop" MouseMove="FilesGrid_MouseMove" SelectionChanged="FilesGrid_SelectionChanged"
                          HeadersVisibility="Column" Background="{StaticResource BgCard}" RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource BgApp}" 
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderLight}">

                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="💾 Download" Command="{Binding DownloadCommand}"/>
                            <MenuItem Header="📖 Quick View" Command="{Binding QuickViewCommand}"/>
                            <MenuItem Header="📂 Navigate to Folder" Command="{Binding OpenInExplorerCommand}"/>
                            <MenuItem Header="📋 Copy FTP Path" Command="{Binding CopyPathCommand}"/>
                            <Separator/>
                            <MenuItem Header="🔄 Rename" Command="{Binding RenameCommand}"/>
                            <MenuItem Header="🗑️ Delete" Command="{Binding DeleteCommand}"/>
                            <Separator/>
                            <MenuItem Header="ℹ️ Properties" Command="{Binding ViewPropertiesCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding TypeIcon}" Width="35">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="File / Folder Name" Binding="{Binding FileName}" FontWeight="Bold" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat='MM/dd/yyyy hh:mm tt'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDeepSearching, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="0,0,15,0">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="0,0,10,0" Foreground="{StaticResource BrandAccent}"/>
                    <TextBlock Text="{Binding DeepSearchStatus}" FontWeight="SemiBold" Foreground="{StaticResource BrandAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Command="{Binding CancelDeepSearchCommand}" Content="❌ CANCEL" Background="#E53E3E" Foreground="White" FontWeight="Bold" Padding="10,2" BorderThickness="0" Cursor="Hand" Visibility="{Binding CanCancelSearch, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="* Double-click a folder to enter" Foreground="{StaticResource TextSecondary}" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button Command="{Binding DownloadCommand}" Content="💾 DOWNLOAD SELECTED" Style="{StaticResource SuccessButton}" Padding="30,15" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- FULL SCREEN BLOCKING OVERLAY -->
        <Border Grid.RowSpan="4" Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Panel.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="300" Height="20" Margin="0,0,0,12" Foreground="{StaticResource BrandPrimary}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="IsIndeterminate" Value="False"/>
                            <Setter Property="Value" Value="{Binding TransferPercentage}"/>
                            <Setter Property="Maximum" Value="100"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransferring}" Value="False">
                                    <Setter Property="IsIndeterminate" Value="True"/>
                                    <Setter Property="Value" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding TransferStatus}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Center" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="Communicating with FTP Server..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransferring}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>