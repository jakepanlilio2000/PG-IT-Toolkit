<UserControl
    x:Class="PuregoldITToolkit.Tools.ScPwdReportTool.Views.ScPwdReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PuregoldITToolkit.Core.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="1"
            Padding="0,0,10,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  1. Target Source  -->
                <Border Margin="0,0,0,15" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrandPrimary}"
                            Text="1. Target Source &amp; Network" />
                        <WrapPanel Margin="0,0,0,15">
                            <StackPanel Width="100" Margin="0,0,25,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Store Code" />
                                <TextBox
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,25,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Live Server IP" />
                                <TextBox FontSize="14" Text="{Binding LiveServerIp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,25,0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Search Date Range" />
                                <StackPanel Orientation="Horizontal">
                                    <DatePicker
                                        Width="140"
                                        Margin="0,0,10,0"
                                        Padding="5"
                                        SelectedDate="{Binding StartDate}" />
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="to" />
                                    <DatePicker
                                        Width="140"
                                        Padding="5"
                                        SelectedDate="{Binding EndDate}" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!--  2. Terminal Options  -->
                <Border Margin="0,0,0,15" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrandPrimary}"
                            Text="2. Terminal Scope" />

                        <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <RadioButton
                                Margin="0,0,25,0"
                                Content="All Terminals (Merged into one report)"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                IsChecked="{Binding MergeAllPos}" />
                            <RadioButton
                                x:Name="RbSpecific"
                                Content="Specific Terminals"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>

                        <!--  Only visible when "Specific Terminals" is selected  -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=RbSpecific, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FormLabel}" Text="Target Lanes" />
                            <TextBox
                                Width="250"
                                HorizontalAlignment="Left"
                                FontSize="14"
                                Text="{Binding PosLanes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondary}"
                                Text="e.g., 1, 2, 5 (Separate with commas)" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  3. Generation Settings  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrandPrimary}"
                            Text="3. Export Configurations" />
                        <WrapPanel Margin="0,0,0,20">
                            <CheckBox
                                Margin="0,0,25,0"
                                Content="Generate Senior Citizen (SC) Report"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                IsChecked="{Binding GenerateScReport}" />
                            <CheckBox
                                Margin="0,0,25,0"
                                Content="Generate PWD Report"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                IsChecked="{Binding GeneratePwdReport}" />
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,40,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Export Date Partition (Chunk Size):" />
                                <TextBox
                                    Width="50"
                                    FontWeight="Bold"
                                    Text="{Binding ReportChunkDays, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Days per .xls file (0 = All dates in one report)" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  Execution Panel  -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{Binding StatusColor}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
            <ProgressBar
                Height="8"
                Margin="0,0,0,15"
                Background="{StaticResource BorderLight}"
                BorderThickness="0"
                Foreground="{StaticResource BrandPrimary}"
                Maximum="100"
                Value="{Binding ProgressValue}" />
            <Button
                Height="55"
                Command="{Binding ProcessCommand}"
                Content="⚡ GENERATE EXCEL REPORTS"
                FontSize="16"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource DangerButton}" />
        </StackPanel>
    </Grid>
</UserControl>
