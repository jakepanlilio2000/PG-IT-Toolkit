<UserControl x:Class="PuregoldITToolkit.Views.InfoHelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Puregold IT Toolkit" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryDark}"/>
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                    <TextBlock Text="Store tools, forms, and daily checks." Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="EJ Consolidator" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="Choose Local to read from your live/CONSO server, FTP for your store’s uploaded files, or FTP Others for another store. Login is automatic." TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <TextBlock Text="Select the store and dates. To find a receipt, enter its number or the ending number without the leading zeros. For example, enter 123 for 7220010000000123. The other receipt filters are ignored while finding a receipt." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Select a result to read it. Use Open output folder to see the saved files." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Forms" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="INF: Add the items and any extra columns, attach screenshots if needed, and prepare the email. Review the recipients before sending." TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <TextBlock Text="OB: Attach your image, then click or drag on the preview to place it. Arrow keys move it a little; Shift + arrow keys move it farther. Change the width to resize it. The saved image uses high quality." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="SSRF and TSRF: Fill in the details, review the preview, then print or save." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="PurePOS" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="Use Connection checks to check the server and registers. The other tabs contain file cleanup, permissions, EJ backup, commands, EOD, and BIR/CRM tools. Messages appear on the right while a task runs." TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Settings and activity" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimary}"/>
                    <TextBlock Text="Set your store, server addresses, output folders, and email recipients in Settings. Activity shows recent messages and lets you save them when reporting a problem." TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
