<Window x:Class="PuregoldITToolkit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Puregold IT Toolkit" Height="850" Width="1400" MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource BgApp}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="HeaderNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCECE3"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tab" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#295643"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BrandAccent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource BgApp}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPrimaryDark}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource BgApp}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrandPrimaryDark}">
            <Grid Margin="24,16,24,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DashboardVm.StoreName}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DashboardVm.StoreCode, StringFormat='Store {0}'}" Foreground="#C1D9CB" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource BrandAccent}" CornerRadius="7" Padding="10,8" Margin="0,0,12,0"><TextBlock Text="PG" FontWeight="Bold" FontSize="19" Foreground="{StaticResource BrandPrimaryDark}"/></Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PUREGOLD" Foreground="White" FontWeight="Bold" FontSize="19"/>
                            <TextBlock Text="IT TOOLKIT" Foreground="#C1D9CB" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <Menu DockPanel.Dock="Right" Background="Transparent" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,5">
                        <MenuItem Header="All tools" ItemsSource="{Binding UtilityTools}" Padding="14,8">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding ToolName}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.SelectUtilityToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                    <ItemsControl ItemsSource="{Binding NavigationLinks}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.NavigateWorkflowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" Style="{StaticResource HeaderNav}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,9">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DashboardVm.CurrentTime}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveWorkflowTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentContent}"/>
            <!-- Docked Real-Time Log Console & Status Strip -->
            <Border Grid.Row="2" Background="{StaticResource DarkSlateBg}" BorderBrush="{StaticResource DarkSlateHeader}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Status Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Expandable Mini Console -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Status Strip Bar -->
                    <Border Grid.Row="0" Padding="15,8" Background="{StaticResource DarkSlateHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Feedback & Timestamp -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding Logger.LatestColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="[" Foreground="#94A3B8" FontFamily="Consolas, Lucida Console" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Logger.LatestTimestamp}" Foreground="#94A3B8" FontFamily="Consolas, Lucida Console" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="]" Foreground="#94A3B8" FontFamily="Consolas, Lucida Console" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Logger.LatestMessage}" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="800"/>
                            </StackPanel>

                            <!-- Actions Strip -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding OpenLogFolderCommand}" Content="📁 Log Folder" Background="Transparent" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1" Padding="8,3" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Command="{Binding ClearLogsCommand}" Content="🧹 Clear" Background="Transparent" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1" Padding="8,3" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>
                                <ToggleButton IsChecked="{Binding IsConsoleExpanded}" Content="▲ Activity" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Expandable Log Console Drawer -->
                    <Border Grid.Row="1" Height="140" Background="#0A0F1D" Padding="10,5" Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding Logger.Logs}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}" Foreground="#64748B" FontFamily="Consolas, Lucida Console" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Level, StringFormat='[{0,-5}]'}" Foreground="{Binding DisplayColor}" FontWeight="Bold" FontFamily="Consolas, Lucida Console" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
