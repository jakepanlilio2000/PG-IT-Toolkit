<UserControl x:Class="PuregoldITToolkit.Views.SystemLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📜 Centralized System &amp; Audit Logs" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}"/>
                    <TextBlock Text="Review localized transaction-level logs, file parsing audits, network connections, and security events." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenLogFolderCommand}" Content="📁 OPEN LOG FOLDER" Style="{StaticResource NeutralButton}" Padding="14,8" Margin="0,0,10,0"/>
                    <Button Command="{Binding ExportLogsCommand}" Content="💾 EXPORT LOGS" Style="{StaticResource ActionButton}" Padding="14,8" Margin="0,0,10,0"/>
                    <Button Command="{Binding ClearLogsCommand}" Content="🧹 CLEAR" Style="{StaticResource DangerButton}" Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Severity Level:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextPrimary}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLevels}" SelectedItem="{Binding SelectedLevel}" Height="34" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="Search Logs:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextPrimary}"/>
                <TextBox Grid.Column="3" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Logs Console / DataList -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="10">
            <ListBox ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" Foreground="#94A3B8" FontFamily="Consolas, Lucida Console" FontSize="12"/>
                            
                            <Border Grid.Column="1" HorizontalAlignment="Left" Padding="6,1" CornerRadius="3" Background="#1E293B">
                                <TextBlock Text="{Binding Level}" Foreground="{Binding DisplayColor}" FontWeight="Bold" FontFamily="Consolas, Lucida Console" FontSize="11"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#F8FAFC" FontFamily="Consolas, Lucida Console" FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>

